  "evidence_principles": [
    "Claims should have identifiable supporting evidence.",
    "Measurements should retain their method and conditions.",
    "Comparative claims should use comparable evidence.",
    "Lifecycle claims should have defined boundaries and methodology.",
    "Regulatory claims should be jurisdiction-specific.",
    "Targets should remain distinct from achieved results.",
    "Hypotheses should remain distinct from established facts.",
    "Evidence should not be generalized beyond its documented scope."
  ],
  "governance": {
    "principles": [
      "Technical terminology should be specific and consistent.",
      "Relationships should be evidence-compatible.",
      "Unsupported universal claims should not be introduced.",
      "Substantive changes should be version-controlled.",
      "The ontology is descriptive and does not establish an industry standard."
    ]
  },
